{
  "name": "nexus-world",
  "version": "0.1.0",
  "description": "A persistent artificial civilization simulation with autonomous AI beings",
  "main": "dist/backend/index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "ts-node-dev --respawn src/backend/index.ts",
    "frontend:dev": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "db:setup": "ts-node src/backend/scripts/setupDatabase.ts",
    "db:seed": "ts-node src/backend/scripts/seedDatabase.ts",
    "start": "node dist/backend/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "simulation",
    "ai",
    "civilization",
    "agents",
    "multi-agent"
  ],
  "author": "NEXUS WORLD Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "typescript": "^5.1.6",
    "jwt-simple": "^0.5.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "uuid": "^9.0.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/jest": "^29.5.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/uuid": "^9.0.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "concurrently": "^8.2.1",
    "jest": "^29.6.3",
    "ts-jest": "^29.1.1",
    "eslint": "^8.46.0",
    "@typescript-eslint/parser": "^6.3.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0"
  }
}
